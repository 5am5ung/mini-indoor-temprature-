#include <LiquidCrystal.h>
#include <Adafruit_NeoPixel.h>
#include <DHT.h>
#include <Wire.h>
#include <Adafruit_BMP085.h> // Library for BMP180 / XC3702

// --- HARDWARE PIN DEFINITIONS ---
// Parallel 4-bit LCD wiring (RS, E, D4, D5, D6, D7)
const int LCD_RS = 8;
const int LCD_E  = 9;
const int LCD_D4 = 4;
const int LCD_D5 = 5;
const int LCD_D6 = 6;
const int LCD_D7 = 7;
const int LCD_BACKLIGHT_PIN = 10; // PWM pin for dynamic sleep dimming

const int DHT_PIN = 2;            // XC4520 Humidity data pin
const int LED_PIN = 3;            // XC4380 WS2812B DIN pin
const int LDR_PIN = A0;           // Ambient Light Sensor (Analog In)
// Note: BMP180 connects via hardware I2C: SDA -> A4, SCL -> A5

// --- HARDWARE INSTANCES ---
LiquidCrystal lcd(LCD_RS, LCD_E, LCD_D4, LCD_D5, LCD_D6, LCD_D7);

#define DHTTYPE DHT11 // Set to DHT22 if using high-precision XC4520
DHT dht(DHT_PIN, DHTTYPE);

#define NUM_LEDS 8
Adafruit_NeoPixel strip(NUM_LEDS, LED_PIN, NEO_GRB + NEO_KHZ800);

Adafruit_BMP085 bmp;
bool bmpAvailable = false;

// --- TIMING & CALIBRATION THRESHOLDS ---
unsigned long lastReadTime = 0;
const unsigned long READ_INTERVAL = 2000; // Sample every 2 seconds

// Light sensor boundaries
const int DARK_LIGHT_LEVEL   = 40;   // Dark bedroom threshold
const int BRIGHT_LIGHT_LEVEL = 700;  // Full room lighting threshold

// Dimming bounds (Night vs Day)
const int MIN_LCD_BACKLIGHT = 4;     // Faint night glow (~1.5% PWM)
const int MAX_LCD_BACKLIGHT = 255;   // Full daytime backlight

// Softened low-glare ceiling for NeoPixels (16 out of 255 = ~6% max power)
const uint8_t MIN_LED_BRIGHTNESS = 1;
const uint8_t MAX_LED_BRIGHTNESS = 16; 

// Helper function: Granular multi-stage stepping calculation
void calculateGranularBrightness(int ldrRaw, uint8_t &ledOut, int &lcdOut, float &colorScaleOut) {
  int ldr = constrain(ldrRaw, DARK_LIGHT_LEVEL, BRIGHT_LIGHT_LEVEL);

  // 5 Granular Stepping Tiers tuned for ultra-soft indicator glow:
  if (ldr <= 60) {
    // Stage 1: Pitch Dark / Bedtime
    lcdOut = 4;
    ledOut = 1;
    colorScaleOut = 0.50f; // Scale down sub-pixel values 50% below the hardware floor
  } 
  else if (ldr <= 150) {
    // Stage 2: Deep Twilight / Nightlight
    lcdOut = 18;
    ledOut = 2;
    colorScaleOut = 0.85f;
  } 
  else if (ldr <= 320) {
    // Stage 3: Low Indoor / Evening Lamp
    lcdOut = 55;
    ledOut = 5;
    colorScaleOut = 1.0f;
  } 
  else if (ldr <= 520) {
    // Stage 4: Overcast / Ambient Daytime Indoor
    lcdOut = 140;
    ledOut = 10;
    colorScaleOut = 1.0f;
  } 
  else {
    // Stage 5: Bright Room / Direct Daylight (Gentle, diffused ceiling of 16)
    lcdOut = 255;
    ledOut = MAX_LED_BRIGHTNESS;
    colorScaleOut = 1.0f;
  }
}

void setup() {
  Serial.begin(9600);

  // Initialize LCD Backlight on PWM
  pinMode(LCD_BACKLIGHT_PIN, OUTPUT);
  analogWrite(LCD_BACKLIGHT_PIN, MAX_LCD_BACKLIGHT);

  // Initialize LCD (16x2)
  lcd.begin(16, 2);
  lcd.clear();
  lcd.print("System Starting");

  // Initialize WS2812B Strip
  strip.begin();
  strip.clear();
  strip.show();

  // Initialize Sensors
  dht.begin();
  Wire.begin();

  if (bmp.begin()) {
    bmpAvailable = true;
    Serial.println("BMP180 initialized successfully.");
  } else {
    bmpAvailable = false;
    Serial.println("BMP180 NOT detected! Check wiring: SDA->A4, SCL->A5.");
    lcd.setCursor(0, 1);
    lcd.print("BMP Not Found!");
  }

  delay(1500);
  lcd.clear();
}

void loop() {
  unsigned long currentMillis = millis();

  if (currentMillis - lastReadTime >= READ_INTERVAL) {
    lastReadTime = currentMillis;

    // 1. Read Sensors
    float temp = 0.0;
    float pressure = 0.0;
    
    if (bmpAvailable) {
      temp = bmp.readTemperature();
      pressure = bmp.readPressure() / 100.0F; // Convert Pa to hPa
    } else {
      temp = dht.readTemperature();
    }

    // Relative Humidity
    float hum = dht.readHumidity();

    // Ambient Light Level
    int ldrValue = analogRead(LDR_PIN);

    // Sensor fault check
    if (isnan(temp) || isnan(hum)) {
      lcd.setCursor(0, 0);
      lcd.print("Sensor Read Err ");
      return;
    }

    // 2. Granular Ambient Dimming Calculation
    uint8_t ledBrightness = 1;
    int lcdBacklight = 4;
    float colorScale = 1.0f;

    calculateGranularBrightness(ldrValue, ledBrightness, lcdBacklight, colorScale);

    // Apply LCD Backlight PWM
    analogWrite(LCD_BACKLIGHT_PIN, lcdBacklight);

    // Apply NeoPixel Brightness and Color Scaling
    strip.setBrightness(ledBrightness);
    updateLedStrip(temp, hum, colorScale);

    // 3. Update LCD Output
    updateLcdDisplay(temp, hum, pressure);
  }
}

void updateLedStrip(float temp, float hum, float scale) {
  strip.clear();

  // Helper lambda for scaling individual color channels:
  // Caps saturated color components at 180 instead of 255 to eliminate harshness
  auto scaleColor = [scale](uint8_t r, uint8_t g, uint8_t b) {
    return strip.Color((uint8_t)(r * scale), (uint8_t)(g * scale), (uint8_t)(b * scale));
  };

  // --- Temperature LEDs (0 to 3) [from BMP180] ---
  if (temp < 24.0) {
    strip.setPixelColor(0, scaleColor(0, 0, 180));       // < 24 C: Soft Blue
  } else if (temp >= 24.0 && temp <= 27.0) {
    strip.setPixelColor(1, scaleColor(0, 180, 0));       // 24-27 C: Soft Green
  } else if (temp > 27.0 && temp <= 32.0) {
    strip.setPixelColor(2, scaleColor(180, 140, 0));     // 28-32 C: Soft Warm Yellow
  } else {
    strip.setPixelColor(3, scaleColor(180, 0, 0));       // > 32 C: Soft Red
  }

  // --- Humidity LEDs (4 to 7) [from XC4520] ---
  if (hum < 40.0) {
    strip.setPixelColor(4, scaleColor(180, 45, 0));      // < 40%: Soft Orange
  } else if (hum >= 40.0 && hum <= 60.0) {
    strip.setPixelColor(5, scaleColor(0, 180, 0));       // 40-60%: Soft Green
  } else if (hum > 60.0 && hum <= 80.0) {
    strip.setPixelColor(6, scaleColor(40, 90, 180));     // 60-80%: Soft Cyan/Blue
  } else {
    strip.setPixelColor(7, scaleColor(0, 0, 180));       // > 80%: Soft Blue
  }

  strip.show();
}

void updateLcdDisplay(float temp, float hum, float pressure) {
  // Line 1: Rounded whole-number Temperature (BMP180) and Humidity (XC4520)
  lcd.setCursor(0, 0);
  lcd.print("T:");
  lcd.print((int)round(temp));
  lcd.print((char)223); // Degree symbol
  lcd.print("C  H:");
  lcd.print((int)round(hum));
  lcd.print("%   ");

  // Line 2: Barometric Pressure (hPa rounded) & Weather Alerts
  lcd.setCursor(0, 1);
  if (bmpAvailable) {
    lcd.print((int)round(pressure));
    lcd.print("hPa ");

    if (pressure < 1000.0) {
      lcd.print("[CYCLONE]");
    } else if (pressure < 1005.0) {
      lcd.print("[MONSOON]");
    } else if (pressure < 1010.0) {
      lcd.print("[RAIN!]  ");
    } else {
      lcd.print("[FAIR]   ");
    }
  } else {
    lcd.print("BMP: Offline    ");
  }
}
