#include <LiquidCrystal.h>
#include <Adafruit_NeoPixel.h>
#include <DHT.h>
#include <Wire.h>
#include <Adafruit_BMP085.h> // Library for BMP180 / BMP085 (XC3702)

// --- PIN DEFINITIONS ---
// Direct parallel 4-bit LCD wiring (RS, E, D4, D5, D6, D7)
const int LCD_RS = 8;
const int LCD_E  = 9;
const int LCD_D4 = 4;
const int LCD_D5 = 5;
const int LCD_D6 = 6;
const int LCD_D7 = 7;
const int LCD_BACKLIGHT_PIN = 10; // PWM pin for dynamic backlight dimming

const int DHT_PIN = 2;            // XC4520 Temperature/Humidity
const int LED_PIN = 3;            // XC4380 WS2812B DIN
const int LDR_PIN = A0;           // Ambient Light Sensor (Analog In)
// Note: BMP180 connects to hardware I2C: SDA -> A4, SCL -> A5

// --- HARDWARE CONFIGURATION ---
LiquidCrystal lcd(LCD_RS, LCD_E, LCD_D4, LCD_D5, LCD_D6, LCD_D7);

#define DHTTYPE DHT11 // Change to DHT22 if using high-precision XC4520
DHT dht(DHT_PIN, DHTTYPE);

#define NUM_LEDS 8
Adafruit_NeoPixel strip(NUM_LEDS, LED_PIN, NEO_GRB + NEO_KHZ800);

Adafruit_BMP085 bmp;
bool bmpAvailable = false;

// Timing & Thresholds
unsigned long lastReadTime = 0;
const unsigned long READ_INTERVAL = 2000;

// Room light calibration thresholds
const int DARK_LIGHT_LEVEL = 40;   // Threshold representing a dark bedroom
const int BRIGHT_LIGHT_LEVEL = 700; // Threshold representing ambient room lighting

// Brightness bounds for night vs. day
const uint8_t MIN_LED_BRIGHTNESS = 1;   // Bare minimum to keep LEDs lit without bedroom glare
const uint8_t MAX_LED_BRIGHTNESS = 120; // Full daylight brightness

const int MIN_LCD_BACKLIGHT = 6;   // Barely visible night glow to read characters
const int MAX_LCD_BACKLIGHT = 255; // Full daylight backlight

void setup() {
  Serial.begin(9600);
  pinMode(LCD_BACKLIGHT_PIN, OUTPUT);
  analogWrite(LCD_BACKLIGHT_PIN, MAX_LCD_BACKLIGHT); // Full on during boot

  lcd.begin(16, 2);
  lcd.clear();
  lcd.print("System Starting");

  strip.begin();
  strip.clear();
  strip.show();

  dht.begin();
  Wire.begin();

  if (bmp.begin()) {
    bmpAvailable = true;
    Serial.println("BMP180 initialized successfully.");
  } else {
    bmpAvailable = false;
    Serial.println("BMP180 NOT detected. Check wiring: SDA->A4, SCL->A5.");
    lcd.setCursor(0, 1);
    lcd.print("BMP Not Found!");
  }

  delay(1500);
  lcd.clear();
}

void loop() {
  unsigned long currentMillis = millis();

  if (currentMillis - lastReadTime >= READ_INTERVAL) {
    lastReadTime = currentMillis;

    float temp = dht.readTemperature();
    float hum  = dht.readHumidity();
    float pressure = 0.0;
    
    if (bmpAvailable) {
      pressure = bmp.readPressure() / 100.0F; // Convert Pa to hPa
    }

    int ldrValue = analogRead(LDR_PIN);

    if (isnan(temp) || isnan(hum)) {
      lcd.setCursor(0, 0);
      lcd.print("DHT Sensor Err  ");
      return;
    }

    // --- CONTINUOUS NIGHT-GLOW DIMMING ---
    // Smoothly scale WS2812B brightness between 1 (night minimum) and 120 (day)
    uint8_t ledBrightness = map(constrain(ldrValue, DARK_LIGHT_LEVEL, BRIGHT_LIGHT_LEVEL),
                                DARK_LIGHT_LEVEL, BRIGHT_LIGHT_LEVEL, 
                                MIN_LED_BRIGHTNESS, MAX_LED_BRIGHTNESS);
    strip.setBrightness(ledBrightness);
    updateLedStrip(temp, hum);

    // Smoothly scale LCD Backlight between 6 (subtle night glow) and 255 (day)
    int lcdBacklight = map(constrain(ldrValue, DARK_LIGHT_LEVEL, BRIGHT_LIGHT_LEVEL),
                           DARK_LIGHT_LEVEL, BRIGHT_LIGHT_LEVEL, 
                           MIN_LCD_BACKLIGHT, MAX_LCD_BACKLIGHT);
    analogWrite(LCD_BACKLIGHT_PIN, lcdBacklight);

    // Refresh LCD text
    updateLcdDisplay(temp, hum, pressure);
  }
}

void updateLedStrip(float temp, float hum) {
  strip.clear();

  // --- Temperature LEDs (0 to 3) ---
  if (temp < 24.0) {
    strip.setPixelColor(0, strip.Color(0, 0, 255));
  } else if (temp >= 24.0 && temp <= 27.0) {
    strip.setPixelColor(1, strip.Color(0, 255, 0));
  } else if (temp > 27.0 && temp <= 32.0) {
    strip.setPixelColor(2, strip.Color(255, 255, 0));
  } else {
    strip.setPixelColor(3, strip.Color(255, 0, 0));
  }

  // --- Humidity LEDs (4 to 7) ---
  if (hum < 40.0) {
    strip.setPixelColor(4, strip.Color(255, 64, 0));
  } else if (hum >= 40.0 && hum <= 60.0) {
    strip.setPixelColor(5, strip.Color(0, 255, 0));
  } else if (hum > 60.0 && hum <= 80.0) {
    strip.setPixelColor(6, strip.Color(64, 128, 255));
  } else {
    strip.setPixelColor(7, strip.Color(0, 0, 255));
  }

  strip.show();
}

void updateLcdDisplay(float temp, float hum, float pressure) {
  // Line 1: Temperature & Humidity
  lcd.setCursor(0, 0);
  lcd.print("T:");
  lcd.print(temp, 1);
  lcd.print((char)223); // Degree symbol
  lcd.print("C H:");
  lcd.print((int)hum);
  lcd.print("%   ");

  // Line 2: Barometric Pressure & Rain Warnings (< 1010 hPa)
  lcd.setCursor(0, 1);
  if (bmpAvailable) {
    lcd.print((int)pressure);
    lcd.print("hPa ");

    if (pressure < 1000.0) {
      lcd.print("[CYCLONE]");
    } else if (pressure < 1005.0) {
      lcd.print("[MONSOON]");
    } else if (pressure < 1010.0) {
      lcd.print("[RAIN!]  ");
    } else {
      lcd.print("[FAIR]   ");
    }
  } else {
    lcd.print("BMP: Offline    ");
  }
}
